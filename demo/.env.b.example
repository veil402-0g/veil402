# Agent B's daemon, overlaying the repo .env.
#
# run-two.sh exports these before starting the second daemon, and an exported
# value wins over the one dotenvy reads from .env — so only what differs for B
# belongs here. Everything else (chain, pool, prover, gateway) is shared.

# Its own port, database and wallet, or the two daemons fight over A's.
VEIL_LISTEN=127.0.0.1:8403
VEIL_DATABASE=sqlite://demo/veil402-b.db?mode=rwc
VEIL_WALLET_STATE=demo/veil402-b-wallet.redb

# Pays gas for nothing in this demo: B only receives, and a note arrives
# without B sending anything. Any valid key will do.
VEIL_SIGNER_KEY=

# run-two.sh appends B's VEIL_SPEND_KEY and VEIL_VIEW_KEY below, from
# `veil402-daemon keygen`. They are the balance: whoever holds them owns
# whatever B is paid.
