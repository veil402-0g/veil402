# Copy to .env and fill in the unset values. Both binaries read this one
# file: the daemon is the buyer and serves the agent API, the gateway is the
# seller and meters the calls. Commented lines show the default.

# ---------------------------------------------------------------- chain ---

VEIL_RPC_URL=https://testnet.hashio.io/api
# VEIL_LOGS_URL=              # defaults to VEIL_RPC_URL; split it when the
                              # log endpoint is a different provider
VEIL_POOL=0x0000000000000000000000000000000000000000
VEIL_TOKEN=0x0000000000000000000000000000000000000000
VEIL_VERIFIER=0x0000000000000000000000000000000000000000

# The block the pool was deployed in. Leaving this at 0 makes the first sync
# walk the whole chain, which on a live network is minutes rather than
# seconds.
VEIL_POOL_BLOCK=0

# VEIL_CHAIN_ID=296           # Hedera testnet
# VEIL_CONFIRMATIONS=0        # Hedera finalises without reorgs
# Blocks per getLogs call. Conservative, because providers differ wildly:
# a public Hedera endpoint serves 50,000 in about a second, while a free
# QuickNode plan caps the same call at 5. A cold index walks from
# VEIL_POOL_BLOCK to the head one call at a time, so raising this is the
# difference between a minute of catching up and a few seconds.
# VEIL_CHUNK=1000
# VEIL_INTERVAL=5             # seconds between sync passes
# VEIL_ATTEMPTS=8             # consecutive failures before the loop gives up

# Hedera prices gas far above most EVM chains; the default clears testnet.
# Too low and walletkit refuses the transaction rather than underpaying it.
# VEIL_MAX_FEE_GWEI=20000

# --------------------------------------------------------------- proving ---

# Build the worker with:
#   cd prover/veil402-gnark && go build -o veil402-gnark .
# Both must be absolute: the daemon and the gateway resolve them from
# whatever directory each was started in.
VEIL_WORKER=/abs/path/to/Veil402/prover/veil402-gnark/veil402-gnark
VEIL_ARTIFACTS=/abs/path/to/Veil402/prover/veil402-gnark/artifacts/transaction-v4

# ------------------------------------------------- buyer: keys and money ---

# Mint with: cargo run -p veil402-daemon -- keygen
# These keys are the balance. Every note's opening is sealed to the viewing
# key and emitted on chain beside its commitment, so a lost database is
# rebuilt by scanning the pool again — but only with these.
VEIL_SPEND_KEY=
VEIL_VIEW_KEY=

# Pays the gas for locks and settlements. Funded, and separate from the
# gateway's own signer.
VEIL_SIGNER_KEY=

# Shield funds before the first call:
#   cargo run -p veil402-daemon -- deposit <amount>
# VEIL_SESSION_NOTE=1000000   # what one envelope is worth, so how often it rolls
# VEIL_ENVELOPE_WINDOW=600    # seconds an envelope may stay open; the pool caps it at an hour
# VEIL_DATABASE=sqlite://veil402.db?mode=rwc
# VEIL_WALLET_STATE=veil402-wallet.redb

# ------------------------------------------------------ buyer: agent API ---

# Where the agent points. OpenAI-shaped, so any client that speaks it works:
#   aider --openai-api-base http://127.0.0.1:8402/v1 --openai-api-key <agent key>
# Issue a key with: cargo run -p veil402-daemon -- key new <label> --budget <units>
# VEIL_LISTEN=127.0.0.1:8402
# VEIL_CALL_CAP=8192          # output tokens a call may ask for when it names no limit

# ------------------------------------------------------- buyer: console ---

# The operator's own credential, for /api/v1. Not an agent key: an agent
# authenticates as itself, while this surface reads across all of them and
# issues the mandates. Left unset, the console stays closed.
VEIL_CONSOLE_TOKEN=
# Where the console is served from, comma separated. The browser refuses a
# cross-origin read without it; the default covers a local Vite server.
# VEIL_CONSOLE_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------- seller: gateway ---

VEIL_GATEWAY_URL=http://127.0.0.1:8401
# VEIL_GATEWAY_BIND=127.0.0.1:8401

# The address the pool pays, and the key the enclave signs with. The pool
# will not accept a lock until this signer is in the enclave registry.
VEIL_SELLER=0x0000000000000000000000000000000000000000
VEIL_GATEWAY_SIGNER=

# Every enclave key derives from this. On real hardware it comes from KMS
# gated on attestation; here it is configuration. 32 bytes, hex, no 0x.
VEIL_ROOT_SEED=

# VEIL_GATEWAY_STATE=veil402-sessions.redb
# VEIL_GATEWAY_WALLET_STATE=veil402-gateway-wallet.redb

# ------------------------------------------------------ seller: upstream ---

VEIL_0G_BASE=https://router-api.0g.ai/v1
VEIL_0G_KEY=
# VEIL_0G_TRUST_MODE=private  # only models whose weights run in an enclave
# VEIL_TOKEN_SCALE=1          # pool units per micro-USD
# VEIL_MARGIN_BPS=0           # the seller's markup over what the upstream charged
# VEIL_CALL_CEILING=4096      # output tokens the seller will admit

# Where the serving contract lives. It names each provider's endpoint and
# the signing key its attestation quote bound to hardware, acknowledged by
# the provider, so neither has to be pinned here — and an auditor can read
# the same record we checked a signature against.
# VEIL_0G_CHAIN_RPC=https://evmrpc.0g.ai
# VEIL_0G_INFERENCE=0x47340d900bdFec2BD393c626E12ea0656F938d84

# ----------------------------------------------------------------- noise ---

# RUST_LOG=veil402_daemon=debug,veil402_gateway=debug
