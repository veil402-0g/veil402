# Copy to .env. Only the first four have no default.
VEIL_RPC_URL=https://testnet.hashio.io/api
VEIL_POOL=0x0000000000000000000000000000000000000000

# Mint with: cargo run -p veil402-daemon -- keygen
# These keys are the balance. Losing them loses it; note ciphertexts are not
# decryptable yet, so nothing on chain can recover a note without them.
VEIL_SPEND_KEY=
VEIL_VIEW_KEY=

# VEIL_DATABASE=sqlite://veil402.db?mode=rwc
# VEIL_CHUNK=1000           # blocks per getLogs call
# VEIL_CONFIRMATIONS=0      # Hedera finalises without reorgs
# VEIL_INTERVAL=5           # seconds between sync passes
# VEIL_ATTEMPTS=8           # consecutive failures before the loop gives up
# VEIL_SESSION_NOTE=1000000 # what a session note is worth; sets how often an envelope rolls
# RUST_LOG=veil402_daemon=debug
